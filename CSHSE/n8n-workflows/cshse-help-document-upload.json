    "name": "CSHSE Help - Document Upload",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "help-upload",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "webhook-upload",
            "name": "Webhook - Upload Document",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2.1,
            "position": [
                -448,
                96
            ],
            "webhookId": "help-upload-webhook",
            "onError": "continueRegularOutput"
        },
        {
            "parameters": {
                "jsCode": "const crypto = require('crypto');\n\nconst input = $input.first();\nconst json = input.json || {};\nconst body = json.body || json;\n\n// Get metadata from request\nconst source = body.source || 'handbook';\nconst title = body.title || 'Help Document';\n\n// Check for base64 data in JSON body\nconst base64Data = body.data;\nconst fileName = body.filename || body.fileName || 'document.pdf';\nconst mimeType = body.mimeType || 'application/pdf';\n\n// Generate job ID\nconst jobId = crypto.randomUUID();\n\n// If we have base64 data, convert it to binary properly\nif (base64Data) {\n  const buffer = Buffer.from(base64Data, 'base64');\n  const binaryData = await this.helpers.prepareBinaryData(\n    buffer,\n    fileName,\n    mimeType\n  );\n  return [{\n    json: {\n      jobId,\n      source,\n      title,\n      fileName,\n      startedAt: new Date().toISOString()\n    },\n    binary: {\n      data: binaryData\n    }\n  }];\n} else if (input.binary && Object.keys(input.binary).length > 0) {\n  // Use existing binary from multipart/form-data upload\n  const binaryKey = Object.keys(input.binary)[0];\n  return [{\n    json: {\n      jobId,\n      source,\n      title,\n      fileName: input.binary[binaryKey].fileName || fileName,\n      startedAt: new Date().toISOString()\n    },\n    binary: input.binary\n  }];\n} else {\n  throw new Error('No file provided. Send either base64-encoded \"data\" field or upload via multipart/form-data.');\n}"
            },
            "id": "validate-input",
            "name": "Validate Input",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -224,
                96
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ JSON.stringify({ status: 'accepted', jobId: $json.jobId, message: 'Help document processing started. Document will be loaded to vector store.' }) }}",
                "options": {}
            },
            "id": "respond-immediately",
            "name": "Respond Immediately",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1.5,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {},
            "id": "load-pdf",
            "name": "Load PDF Document",
            "type": "n8n-nodes-base.readPDF",
            "typeVersion": 1,
            "position": [
                0,
                192
            ]
        },
        {
            "parameters": {
                "jsCode": "const items = $input.all();\nconst jobConfig = $('Validate Input').first().json;\n\nconst enrichedDocs = items.map((item, index) => {\n  const doc = item.json;\n  \n  return {\n    json: {\n      pageContent: doc.text || doc.pageContent || '',\n      metadata: {\n        source: jobConfig.source,\n        title: jobConfig.title,\n        chunkIndex: index,\n        fileName: jobConfig.fileName,\n        numPages: doc.numpages || 0,\n        loadedAt: new Date().toISOString()\n      }\n    }\n  };\n});\n\nreturn enrichedDocs;"
            },
            "id": "add-metadata",
            "name": "Add Metadata",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                224,
                192
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.openai.com/v1/embeddings",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "openAiApi",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"input\": {{ JSON.stringify($json.pageContent) }},\n  \"model\": \"text-embedding-ada-002\"\n}",
                "options": {
                    "timeout": 60000
                }
            },
            "id": "get-embeddings",
            "name": "Get OpenAI Embeddings",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                448,
                192
            ],
            "credentials": {
                "openAiApi": {
                    "id": "xSzPIySN61drme77",
                    "name": "OpenAi account"
                }
            }
        },
        {
            "parameters": {
                "tableId": "help_documents",
                "fieldsUi": {
                    "fieldValues": [
                        {
                            "fieldId": "content",
                            "fieldValue": "={{ JSON.stringify($('Add Metadata').item.json.pageContent) }}"
                        },
                        {
                            "fieldId": "metadata",
                            "fieldValue": "={{ JSON.stringify($('Add Metadata').item.json.metadata) }}"
                        },
                        {
                            "fieldId": "embedding",
                            "fieldValue": "={{ JSON.stringify($json.data[0].embedding) }}"
                        }
                    ]
                }
            },
            "type": "n8n-nodes-base.supabase",
            "typeVersion": 1,
            "position": [
                672,
                192
            ],
            "id": "create-row",
            "name": "Create a row",
            "credentials": {
                "supabaseApi": {
                    "id": "qU6Q7CRvJhUXZABY",
                    "name": "Supabase account"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const items = $input.all();\nconst jobConfig = $('Validate Input').first().json;\n\nconst result = {\n  success: true,\n  jobId: jobConfig.jobId,\n  source: jobConfig.source,\n  title: jobConfig.title,\n  fileName: jobConfig.fileName,\n  documentsLoaded: items.length,\n  processedAt: new Date().toISOString(),\n  processingDuration: Date.now() - new Date(jobConfig.startedAt).getTime(),\n  message: `Successfully loaded ${items.length} document chunks from ${jobConfig.fileName}`\n};\n\nreturn [{ json: result }];"
            },
            "id": "aggregate-results",
            "name": "Aggregate Results",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                896,
