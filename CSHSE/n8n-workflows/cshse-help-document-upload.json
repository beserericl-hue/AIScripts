    "isArchived": false,
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "help-upload",
                "options": {
                    "rawBody": true
                },
                "responseMode": "lastNode"
            },
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2.1,
            "position": [
                180,
                300
            ],
            "id": "webhook-upload",
            "name": "Webhook - Upload Document"
        },
        {
            "parameters": {
                "jsCode": "// Extract text from the uploaded file\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const binaryData = item.binary;\n  if (!binaryData || !binaryData.file) {\n    results.push({ json: { error: 'No file uploaded' } });\n    continue;\n  }\n\n  const fileData = binaryData.file;\n  const mimeType = fileData.mimeType || '';\n  const fileName = fileData.fileName || 'unknown';\n  const source = item.json.body?.source || 'unknown';\n  const title = item.json.body?.title || fileName;\n\n  // Get the buffer\n  const buffer = await this.helpers.getBinaryDataBuffer(item, 'file');\n  let text = '';\n\n  if (mimeType === 'application/pdf') {\n    // Use pdf-parse for PDF files\n    const pdfParse = require('pdf-parse');\n    const pdfData = await pdfParse(buffer);\n    text = pdfData.text;\n  } else if (mimeType === 'text/markdown' || fileName.endsWith('.md')) {\n    text = buffer.toString('utf-8');\n  } else if (mimeType === 'text/plain' || fileName.endsWith('.txt')) {\n    text = buffer.toString('utf-8');\n  } else {\n    results.push({ json: { error: `Unsupported file type: ${mimeType}` } });\n    continue;\n  }\n\n  // Split text into chunks with overlap\n  const chunkSize = 1000;\n  const chunkOverlap = 200;\n  const chunks = [];\n  let start = 0;\n\n  while (start < text.length) {\n    const end = Math.min(start + chunkSize, text.length);\n    const chunk = text.substring(start, end);\n    if (chunk.trim().length > 0) {\n      chunks.push({\n        json: {\n          content: chunk,\n          metadata: {\n            source: source,\n            title: title,\n            chunkIndex: chunks.length,\n            fileName: fileName\n          }\n        }\n      });\n    }\n    start += chunkSize - chunkOverlap;\n  }\n\n  results.push(...chunks);\n}\n\nreturn results;"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                420,
                300
            ],
            "id": "extract-text",
            "name": "Extract & Chunk Text"
        },
