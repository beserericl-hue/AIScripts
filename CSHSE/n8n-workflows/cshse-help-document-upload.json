    {
      "parameters": {
        "jsCode": "// Generate UUID without crypto module\nfunction generateUUID() {\n  return \"xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx\".replace(/[xy]/g, function(c) {\n    var r = Math.random() * 16 | 0, v = c === \"x\" ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n}\n\nconst input = $input.first();\nconst json = input.json || {};\nconst body = json.body || json;\n\n// Get metadata from request\nconst source = body.source || 'handbook';\nconst title = body.title || 'Help Document';\n\n// Get callback info for status tracking\nconst callbackUrl = body.callbackUrl || '';\nconst docId = body.docId || '';\n\n// Check for base64 data in JSON body\nconst base64Data = body.data;\nconst fileName = body.filename || body.fileName || 'document.pdf';\nconst mimeType = body.mimeType || 'application/pdf';\n\n// Determine file type\nconst ext = fileName.split('.').pop().toLowerCase();\nconst isPdf = ext === 'pdf' || mimeType === 'application/pdf';\n\n// Generate job ID\nconst jobId = generateUUID();\n\n// If we have base64 data, convert it to binary properly\nif (base64Data) {\n  const buffer = Buffer.from(base64Data, 'base64');\n  const binaryData = await this.helpers.prepareBinaryData(\n    buffer,\n    fileName,\n    mimeType\n  );\n  return [{\n    json: {\n      jobId,\n      source,\n      title,\n      fileName,\n      isPdf,\n      callbackUrl,\n      docId,\n      startedAt: new Date().toISOString()\n    },\n    binary: {\n      data: binaryData\n    }\n  }];\n} else if (input.binary && Object.keys(input.binary).length > 0) {\n  // Use existing binary from multipart/form-data upload\n  const binaryKey = Object.keys(input.binary)[0];\n  const binFile = input.binary[binaryKey];\n  const binFileName = binFile.fileName || fileName;\n  const binExt = binFileName.split('.').pop().toLowerCase();\n  const binIsPdf = binExt === 'pdf' || (binFile.mimeType || '').includes('pdf');\n  return [{\n    json: {\n      jobId,\n      source,\n      title,\n      fileName: binFileName,\n      isPdf: binIsPdf,\n      callbackUrl,\n      docId,\n      startedAt: new Date().toISOString()\n    },\n    binary: { data: input.binary[binaryKey] }\n  }];\n} else {\n  throw new Error('No file provided. Send either base64-encoded \"data\" field or upload via multipart/form-data.');\n}"
      },
