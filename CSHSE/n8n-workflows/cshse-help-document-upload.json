    {
      "parameters": {
        "jsCode": "// Read text/markdown file from binary and split into chunks\nconst input = $input.first();\nconst binaryKey = Object.keys(input.binary)[0];\nconst binaryData = input.binary[binaryKey];\n\n// Get the text content from binary\nconst buffer = await this.helpers.getBinaryDataBuffer(0, binaryKey);\nconst text = buffer.toString('utf-8');\n\nif (!text || text.trim().length === 0) {\n  throw new Error('File is empty or could not be read as text.');\n}\n\n// Chunk the text (1000 chars with 200 overlap, similar to typical RAG chunking)\nconst CHUNK_SIZE = 1000;\nconst CHUNK_OVERLAP = 200;\nconst chunks = [];\nlet start = 0;\n\nwhile (start < text.length) {\n  let end = start + CHUNK_SIZE;\n  \n  // Try to break at a paragraph or sentence boundary\n  if (end < text.length) {\n    // Look for paragraph break\n    const paraBreak = text.lastIndexOf('\\n\\n', end);\n    if (paraBreak > start + CHUNK_SIZE * 0.5) {\n      end = paraBreak + 2;\n    } else {\n      // Look for sentence break\n      const sentBreak = text.lastIndexOf('. ', end);\n      if (sentBreak > start + CHUNK_SIZE * 0.5) {\n        end = sentBreak + 2;\n      }\n    }\n  } else {\n    end = text.length;\n  }\n  \n  const chunk = text.slice(start, end).trim();\n  if (chunk.length > 0) {\n    chunks.push({\n      json: {\n        text: chunk,\n        numpages: 0\n      }\n    });\n  }\n  \n  start = end - CHUNK_OVERLAP;\n  if (start >= text.length) break;\n}\n\nreturn chunks;"
      },
