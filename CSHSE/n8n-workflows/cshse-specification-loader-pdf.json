    "name": "CSHSE Specification Loader (PDF)",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "load-specifications",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "05020f32-2f4d-4815-9760-e28437fc2ef2",
            "name": "Webhook - Load Specs",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2.1,
            "position": [
                -448,
                96
            ],
            "webhookId": "load-specs-webhook",
            "onError": "continueRegularOutput"
        },
        {
            "parameters": {
                "jsCode": "const crypto = require('crypto');\n\nconst input = $input.first();\nconst json = input.json || {};\nconst body = json.body || json;\n\n// Get metadata from request\nconst specName = body.specName || 'CSHSE Standards';\nconst specVersion = body.specVersion || '1.0';\nconst specId = body.specId || null;\nconst callbackUrl = body.callbackUrl || null;\n\n// Check for base64 data in JSON body\nconst base64Data = body.data;\nconst fileName = body.filename || body.fileName || 'specification.pdf';\nconst mimeType = body.mimeType || 'application/pdf';\n\n// Generate job ID\nconst jobId = crypto.randomUUID();\n\n// If we have base64 data, convert it to binary properly\nif (base64Data) {\n  // Convert base64 to Buffer\n  const buffer = Buffer.from(base64Data, 'base64');\n  \n  // Use n8n's binary data format\n  const binaryData = await this.helpers.prepareBinaryData(\n    buffer,\n    fileName,\n    mimeType\n  );\n  \n  return [{\n    json: {\n      jobId,\n      specName,\n      specVersion,\n      specId,\n      callbackUrl,\n      fileName,\n      startedAt: new Date().toISOString()\n    },\n    binary: {\n      data: binaryData\n    }\n  }];\n} else if (input.binary && Object.keys(input.binary).length > 0) {\n  // Use existing binary from multipart/form-data upload\n  return [{\n    json: {\n      jobId,\n      specName,\n      specVersion,\n      specId,\n      callbackUrl,\n      fileName: input.binary[Object.keys(input.binary)[0]].fileName || fileName,\n      startedAt: new Date().toISOString()\n    },\n    binary: input.binary\n  }];\n} else {\n  throw new Error('No PDF file provided. Send either base64-encoded \"data\" field or upload via multipart/form-data.');\n}"
            },
            "id": "6ceca162-2dde-40e2-a521-8168c3f3de2f",
            "name": "Validate Input",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -224,
                96
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ JSON.stringify({ status: 'accepted', jobId: $json.jobId, message: 'PDF processing started. Specifications will be loaded to vector store.' }) }}",
                "options": {}
            },
            "id": "48aed2a2-3487-41ca-8de5-011b71f7378d",
            "name": "Respond Immediately",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1.5,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {},
            "id": "27af2911-82b6-4511-951c-05f595087da3",
            "name": "Load PDF Document",
            "type": "n8n-nodes-base.readPDF",
            "typeVersion": 1,
            "position": [
                0,
                192
            ]
        },
        {
            "parameters": {
                "jsCode": "const items = $input.all();\nconst jobConfig = $('Validate Input').first().json;\n\nconst enrichedDocs = items.map((item, index) => {\n  const doc = item.json;\n  \n  return {\n    json: {\n      pageContent: doc.text || doc.pageContent || '',\n      metadata: {\n        specName: jobConfig.specName,\n        specVersion: jobConfig.specVersion,\n        specId: jobConfig.specId,\n        chunkIndex: index,\n        fileName: jobConfig.fileName,\n        numPages: doc.numpages || 0,\n        loadedAt: new Date().toISOString()\n      }\n    }\n  };\n});\n\nreturn enrichedDocs;"
            },
            "id": "07b6ffc3-2304-40d7-93ca-d62a7706e01f",
            "name": "Add Metadata",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                224,
                192
            ]
        },
        {
            "parameters": {
                "jsCode": "const items = $input.all();\nconst jobConfig = $('Validate Input').first().json;\n\nconst result = {\n  success: true,\n  jobId: jobConfig.jobId,\n  specName: jobConfig.specName,\n  specVersion: jobConfig.specVersion,\n  specId: jobConfig.specId,\n  fileName: jobConfig.fileName,\n  documentsLoaded: items.length,\n  processedAt: new Date().toISOString(),\n  processingDuration: Date.now() - new Date(jobConfig.startedAt).getTime(),\n  message: `Successfully loaded ${items.length} document chunks from ${jobConfig.fileName}`\n};\n\nreturn [{ json: { ...result, callbackUrl: jobConfig.callbackUrl } }];"
            },
            "id": "9d443c8d-15b4-4277-875d-fa00825d10a8",
            "name": "Aggregate Results",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                896,
                192
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $json.callbackUrl }}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "X-API-Key",
                            "value": "cshse_eXPTLboS18Gjgw_BTwEVJhe8CBiAjq9B"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"status\": \"completed\",\n  \"jobId\": {{ JSON.stringify($json.jobId) }},\n  \"specName\": {{ JSON.stringify($json.specName) }},\n  \"specVersion\": {{ JSON.stringify($json.specVersion) }},\n  \"specId\": {{ JSON.stringify($json.specId) }},\n  \"documentsLoaded\": {{ $json.documentsLoaded }},\n  \"fileName\": {{ JSON.stringify($json.fileName) }},\n  \"processedAt\": {{ JSON.stringify($json.processedAt) }},\n  \"message\": {{ JSON.stringify($json.message) }}\n}",
                "options": {
                    "timeout": 30000
                }
            },
            "id": "3caaa596-e2eb-41d3-acd3-935a3dd57445",
            "name": "Send Callback",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1344,
